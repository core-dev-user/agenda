{
  "name": "widgy",
  "productName": "Widgy",
  "version": "0.3.30",
  "description": "Widgy — sua área de trabalho personalizada",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env AGENDA_DEV=1 electron .\"",
    "build": "npm run icon && node scripts/generate-icon-pack.mjs && tsc -b && vite build",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder --win --dir",
    "release": "node scripts/release.mjs",
    "predev": "npm run icon && node scripts/generate-icon-pack.mjs",
    "test:media": "node --experimental-strip-types --test tests/pcmedia.test.cjs tests/spectrum.test.cjs tests/cover-match.test.mjs",
    "test:security": "node --test tests/security-network.test.cjs",
    "test:finance": "node --test tests/finance-save.test.cjs",
    "test:perf": "node --experimental-strip-types --test tests/perf-policy.test.cjs tests/carbono-icons.test.mjs",
    "test:wallpaper": "node --test tests/wallpaper-engine.test.cjs",
    "test:taskbar": "node --test tests/taskbar*.test.cjs",
    "test:taskbar:windows": "electron tests/taskbar-preview-smoke.cjs",
    "test:rooms": "node --experimental-strip-types --test tests/rtc-tuning.test.mjs tests/share-picker.test.cjs",
    "test:templates": "node --experimental-strip-types --test tests/template-share.test.mjs tests/settings-index.test.mjs tests/icon-support.test.mjs",
    "test:a11y": "node --test tests/a11y-static.test.mjs"
  },
  "build": {
    "appId": "com.agenda.desktop",
    "productName": "Widgy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Widgy",
      "artifactName": "Widgy-Setup-${version}.${ext}",
      "uninstallDisplayName": "Widgy",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "core-dev-user",
        "repo": "agenda",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Widgy Template",
        "schemes": [
          "widgy"
        ]
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/major-mono-display": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@huggingface/transformers": "^3.7.6",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "pdfjs-dist": "^4.10.38",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16",
    "@fortawesome/fontawesome-free": "6.7.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "44.10.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@44.10.2": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
